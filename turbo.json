{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**"]
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "db:migrate": {
      "cache": false
    },
    "db:seed": {
      "cache": false
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    }
  },
  "globalEnv": [
    "NODE_ENV",
    "CI",
    "SERVORA_SEO_TEST_BUILD",
    "VERCEL_ENV",
    "RENDER",
    "SERVORA_VALIDATE_PRODUCTION_ENV",
    "NEXT_PUBLIC_*",
    "VITE_PUBLIC_APP_URL",
    "LEAD_WEBHOOK_URL"
  ]
}
