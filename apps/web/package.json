    "@tanstack/react-query-devtools": "^5.45.0",
    "axios": "^1.7.2",
    "zustand": "^4.5.4",
    "lucide-react": "^0.395.0",
    "qrcode.react": "^4.2.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.3.0",
    "date-fns": "^3.6.0",
    "@pos/types": "workspace:*",
    "@pos/validation": "workspace:*",
    "@pos/ui": "workspace:*",
    "@pos/api-client": "workspace:*",
    "@pos/realtime": "workspace:*",
    "@hookform/resolvers": "^3.6.0",
