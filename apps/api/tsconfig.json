{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["bun-types"],
    "paths": {
      "@/*": ["./src/*"],
      "@pos/types": ["../../packages/types/src/index.ts"],
      "@pos/contracts": ["../../packages/contracts/src/index.ts"],
      "@pos/contracts/*": ["../../packages/contracts/src/*"]
    },
    "baseUrl": "."
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
