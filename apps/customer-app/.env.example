# Backend API and realtime endpoints.
VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000/ws/events

# Optional public Razorpay key for customer checkout.
VITE_RAZORPAY_KEY_ID=

# Canonical public origin used only for static social preview metadata.
VITE_PUBLIC_APP_URL=http://localhost:5176

# Optional endpoint for sampled frontend Web Vitals and runtime error telemetry.
VITE_FRONTEND_TELEMETRY_URL=
