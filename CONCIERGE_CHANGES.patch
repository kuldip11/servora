+import type { AssistantLanguage, AssistantReply } from "@pos/contracts";
+import { customerMenuService } from "@/modules/customer/customer-menu.service";
+import type { MenuSearchInput } from "./assistant.input";
+import { reply, staffReply } from "./assistant.responses";
+import { searchItems } from "./assistant.search";
+
+async function resolveRecommendation(
+  token: string,
+  language: AssistantLanguage,
+  canCallWaiter: boolean,
+  input: MenuSearchInput,
+): Promise<AssistantReply> {
+  if (input.needsDietaryVerification)
+    return reply(language, "ASK_STAFF", canCallWaiter);
+  if (input.intent === "STAFF") return staffReply(language, canCallWaiter);
+  if (input.intent === "OUT_OF_SCOPE")
+    return reply(language, "OUT_OF_SCOPE", canCallWaiter);
+
+  // Resolve authoritative availability/prices after classification completes.
+  // No database call runs inside the provider's tool execution lifecycle.
+  const menu = await customerMenuService.getMenu(token);
+  const items = searchItems(menu.items, input);
+  return reply(
+    language,
+    items.length ? "MATCHES" : "NO_MATCH",
+    canCallWaiter,
+    items,
+  );
+}
+
+export const assistantRecommendationService = {
+  resolve: resolveRecommendation,
+};
