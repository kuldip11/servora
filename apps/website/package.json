{
  "name": "@pos/website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "validate:production-env": "node scripts/validate-production-env.mjs",
    "start": "next start --port 3001",
    "typecheck": "tsc --noEmit",
    "lint": "eslint 'app/**/*.{ts,tsx}' 'components/**/*.{ts,tsx}' 'content/**/*.{ts,tsx}' 'lib/**/*.{ts,tsx}'",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "next": "^15.5.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "lucide-react": "^0.395.0",
    "@pos/ui": "workspace:*",
    "@pos/config": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.4.5",
    "eslint": "^9.39.5",
    "tailwindcss": "^3.4.4",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss-animate": "^1.0.7",
    "vitest": "1.6.1",
    "@playwright/test": "^1.55.0",
    "@axe-core/playwright": "^4.10.2",
    "@vitest/coverage-v8": "1.6.1"
  }
}
