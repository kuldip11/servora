{
  "name": "restaurant-pos-saas",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:website": "cd apps/website && bun run build",
    "dev": "turbo run dev",
    "dev:website": "cd apps/website && bun run dev",
    "test": "turbo run test",
    "lint": "eslint 'apps/**/*.{ts,tsx}' 'packages/**/*.{ts,tsx}'",
    "typecheck": "turbo run typecheck",
    "db:migrate": "cd apps/api && bun run db:migrate",
    "db:reset": "cd apps/api && bun run db:reset",
    "db:seed": "cd apps/api && bun run db:seed",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "test:a11y": "cd apps/web && bun run test:a11y",
    "audit:rbac": "bash scripts/audit/rbac-static.sh && node scripts/audit/verify-permissions.mjs",
    "test:coverage": "bun run test:coverage:validation && bun run test:coverage:types && bun run test:coverage:config && bun run test:coverage:api-client && bun run test:coverage:realtime && bun run test:coverage:api && bun run test:coverage:ui && bun run test:coverage:web && bun run test:coverage:waiter && bun run test:coverage:kitchen && bun run test:coverage:customer && bun run test:coverage:website",
    "test:coverage:api": "cd apps/api && bun run test:coverage",
    "test:coverage:ui": "cd packages/ui && bun run test:coverage",
    "test:e2e": "cd apps/web && bun run test:e2e",
    "test:e2e:ui": "cd apps/web && bun run test:watch",
    "test:coverage:all": "bun run test:coverage",
    "test:coverage:web": "cd apps/web && bun run test:coverage",
    "test:coverage:waiter": "cd apps/waiter-app && bun run test:coverage",
    "test:coverage:kitchen": "cd apps/kitchen-display && bun run test:coverage",
    "test:coverage:validation": "cd packages/validation && bun run test:coverage",
    "test:coverage:api-client": "cd packages/api-client && bun run test:coverage",
    "test:coverage:realtime": "cd packages/realtime && bun run test:coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:coverage:customer": "cd apps/customer-app && bun run test:coverage",
    "start:website": "cd apps/website && bun run start",
    "typecheck:website": "cd apps/website && bun run typecheck",
    "lint:website": "cd apps/website && bun run lint",
    "test:website": "cd apps/website && bun run test",
    "test:e2e:website": "cd apps/website && bun run test:e2e",
    "verify": "bun run verify:baseline",
    "verify:apps": "bun run typecheck:website && bun run test:website && bun run build:website && bun run typecheck && bun run test",
    "build:apps": "turbo run build --filter=./apps/*",
    "typecheck:apps": "turbo run typecheck --filter=./apps/*",
    "test:apps": "turbo run test --filter=./apps/*",
    "verify:foundation": "bun run validate:env && bun run lint && bun run typecheck:apps && bun run build:apps",
    "validate:env": "node scripts/foundation/validate-env-examples.mjs",
    "verify:baseline": "node scripts/release/verify-baseline.mjs",
    "verify:baseline:plan": "node scripts/release/verify-baseline.mjs --plan",
    "verify:baseline:all": "node scripts/release/verify-baseline.mjs --keep-going",
    "verify:migrations": "node scripts/release/verify-migrations.mjs",
    "db:verify:migrations": "node scripts/release/verify-migrations.mjs",
    "verify:performance": "node scripts/release/performance-smoke.mjs",
    "release:certify": "node scripts/release/certify-release.mjs",
    "db:backup": "sh scripts/release/backup-postgres.sh",
    "db:restore": "sh scripts/release/restore-postgres.sh",
    "validate:production-env": "node scripts/release/validate-production-env.mjs",
    "smoke:production": "node scripts/release/production-smoke.mjs",
    "demo:seed": "cd apps/api && bun run demo:seed",
    "demo:reset": "cd apps/api && bun run demo:reset",
    "test:coverage:config": "cd packages/config && bun run test:coverage",
    "test:coverage:types": "cd packages/types && bun run test:coverage",
    "test:coverage:website": "cd apps/website && bun run test:coverage"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "turbo": "^2.0.0",
    "typescript": "^5.4.5",
    "prettier": "^3.6.2",
    "@typescript-eslint/parser": "^8.66.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "bun": ">=1.1.0"
  },
  "dependencies": {}
}
