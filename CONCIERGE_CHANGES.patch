+  tagLinks: Array<{ tag: { name: string } }>;
+};
+
+export function searchItems(
+  items: SearchableItem[],
+  input: MenuSearchInput,
+): AssistantReply["items"] {
+  const terms = input.terms
+    .map((t) => t.toLocaleLowerCase().trim())
+    .filter(Boolean);
+  return items
+    .filter((item) => {
+      const price = Number(item.basePrice);
+      if (!Number.isFinite(price) || price < 0) return false;
+      if (input.foodType !== "ANY" && item.foodType !== input.foodType)
+        return false;
+      if (input.mild && !["MILD", "NONE"].includes(item.spiceLevel ?? ""))
+        return false;
+      // No misleading budget claims for weight/open prices or configurable items.
+      if (
+        input.maxPrice !== null &&
+        (price > input.maxPrice ||
+          item.pricingMode !== "FIXED" ||
+          item.variants.length ||
+          item.modifierGroupLinks.length)
+      )
+        return false;
+      return true;
+    })
+    .map((item) => {
+      const haystack =
+        `${item.name} ${item.description ?? ""} ${item.tagLinks.map((l) => l.tag.name).join(" ")}`.toLocaleLowerCase();
+      return {
+        item,
+        score: terms.reduce(
+          (sum, term) => sum + Number(haystack.includes(term)),
+          0,
+        ),
+      };
+    })
+    .filter((row) => !terms.length || row.score > 0)
+    .sort(
+      (a, b) =>
+        b.score - a.score ||
+        Number(a.item.basePrice) - Number(b.item.basePrice) ||
+        a.item.id.localeCompare(b.item.id),
+    )
+    .slice(0, 4)
+    .map(({ item }) => ({
+      id: item.id,
+      name: item.name,
+      basePrice: String(item.basePrice),
+      foodType: item.foodType,
+      spiceLevel: item.spiceLevel,
+    }));
+}
