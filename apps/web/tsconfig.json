{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@pos/types": ["../../packages/types/src/index.ts"],
      "@pos/validation": ["../../packages/validation/src/index.ts"],
      "@pos/ui": ["../../packages/ui/src/index.tsx"],
      "@pos/api-client": ["../../packages/api-client/src/index.ts"],
      "@pos/realtime": ["../../packages/realtime/src/index.ts"]
    },
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["src", "vite.config.ts"],
  "exclude": ["node_modules", "dist"]
}
