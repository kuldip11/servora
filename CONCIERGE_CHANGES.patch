+            >
+              {t.open}
+              <ArrowUpRight className="h-4 w-4" aria-hidden="true" />
+            </button>
+          </li>
+        ))}
+      </ul>
+      <p className="text-xs leading-relaxed text-text-secondary">
+        {result.disclaimer}
+      </p>
+    </>
+  );
+}
