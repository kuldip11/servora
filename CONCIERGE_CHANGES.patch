+    state.menu.mockResolvedValue({ items: [] });
+    const second = await post("Not spicy");
+    expect((await readReply(second)).data.outcome).toBe("NO_MATCH");
+    expect(state.menu).toHaveBeenCalledTimes(2);
+  });
+});
