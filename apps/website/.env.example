# TODO: replace every .example URL before a production build.
# No real deployment domain has been supplied; these are documentation placeholders.
NEXT_PUBLIC_SITE_URL=https://servora.example
NEXT_PUBLIC_APP_SIGNIN_URL=https://app.servora.example/login

# Servora application URLs exposed in the public website footer.
NEXT_PUBLIC_WEB_APP_URL=https://app.servora.example
NEXT_PUBLIC_KITCHEN_APP_URL=https://kitchen.servora.example
NEXT_PUBLIC_WAITER_APP_URL=https://waiter.servora.example
NEXT_PUBLIC_CUSTOMER_APP_URL=https://order.servora.example
# Server-side endpoint receiving validated lead JSON. Keep this secret.
LEAD_WEBHOOK_URL=https://example.com/your-lead-webhook
# Optional: analytics loads only after optional-cookie consent.
NEXT_PUBLIC_GA_ID=

# Production checklist: set a real HTTPS endpoint owned by your CRM/automation provider.
# The endpoint must accept JSON POST requests and return a 2xx response.

# Enable only behind ingress that overwrites client IP headers.
LEAD_TRUST_PROXY_HEADERS=false
