    "tailwindcss": "^3.4.4",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "vitest": "^1.6.0",
    "@playwright/test": "^1.44.1",
    "@axe-core/playwright": "^4.11.0",
    "jsdom": "^24.1.0",
    "@vitest/coverage-v8": "^1.6.0",
    "@testing-library/react": "^16.0.0"
  }
